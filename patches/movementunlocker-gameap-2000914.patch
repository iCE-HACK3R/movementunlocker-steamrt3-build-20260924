+#ifdef __linux__
+struct PatternSearchContext
+{
+	uintptr_t ModuleAddress;
+	const unsigned char* Data;
+	const char* Pattern;
+	uintptr_t Match;
+	size_t MatchCount;
+};
+
+static bool PatternMatches(const unsigned char* memory, const unsigned char* data, const char* pattern, size_t length)
+{
+	for (size_t i = 0; i < length; i++)
+	{
+		if (pattern[i] == 'x' && memory[i] != data[i])
+			return false;
+	}
+	return true;
+}
+
+static int FindPatternInModule(struct dl_phdr_info* info, size_t, void* opaque)
+{
+	auto* context = static_cast<PatternSearchContext*>(opaque);
+	bool containsModuleAddress = false;
+	for (ElfW(Half) i = 0; i < info->dlpi_phnum; i++)
+	{
+		const ElfW(Phdr)& segment = info->dlpi_phdr[i];
+		if (segment.p_type != PT_LOAD)
+			continue;
+
+		const uintptr_t begin = info->dlpi_addr + segment.p_vaddr;
+		if (context->ModuleAddress >= begin && context->ModuleAddress < begin + segment.p_memsz)
+		{
+			containsModuleAddress = true;
+			break;
+		}
+	}
+
+	if (!containsModuleAddress)
+		return 0;
+
+	const size_t patternLength = strlen(context->Pattern);
+	for (ElfW(Half) i = 0; i < info->dlpi_phnum; i++)
+	{
+		const ElfW(Phdr)& segment = info->dlpi_phdr[i];
+		if (segment.p_type != PT_LOAD || !(segment.p_flags & PF_X) || segment.p_memsz < patternLength)
+			continue;
+
+		const auto* begin = reinterpret_cast<const unsigned char*>(info->dlpi_addr + segment.p_vaddr);
+		const size_t lastOffset = segment.p_memsz - patternLength;
+		for (size_t offset = 0; offset <= lastOffset; offset++)
+		{
+			if (!PatternMatches(begin + offset, context->Data, context->Pattern, patternLength))
+				continue;
+
+			context->Match = reinterpret_cast<uintptr_t>(begin + offset);
+			context->MatchCount++;
+			if (context->MatchCount > 1)
+				return 1;
+		}
+	}
+	return 1;
+}
+
+static uintptr_t FindUniquePatternInModule(uintptr_t moduleAddress, const unsigned char* data, const char* pattern)
+{
+	PatternSearchContext context{moduleAddress, data, pattern, 0, 0};
+	dl_iterate_phdr(FindPatternInModule, &context);
+	return context.MatchCount == 1 ? context.Match : 0;
+}
+#endif
